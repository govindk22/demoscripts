Database Schema
repositories
CREATE TABLE repositories
(
    id UUID PRIMARY KEY,

    name VARCHAR(200),

    git_url TEXT,

    default_branch VARCHAR(100),

    created_date TIMESTAMP
);
scans
CREATE TABLE scans
(
    id UUID PRIMARY KEY,

    repository_id UUID,

    status VARCHAR(50),

    started_at TIMESTAMP,

    completed_at TIMESTAMP,

    commit_hash VARCHAR(100)
);
findings
CREATE TABLE findings
(
    id UUID PRIMARY KEY,

    scan_id UUID,

    file_name TEXT,

    line_number INTEGER,

    category VARCHAR(100),

    severity VARCHAR(50),

    title TEXT,

    description TEXT,

    recommendation TEXT
);
architecture_summary
CREATE TABLE architecture_summary
(
    scan_id UUID PRIMARY KEY,

    summary TEXT,

    patterns TEXT,

    risks TEXT,

    recommendations TEXT
);
technical_debt
CREATE TABLE technical_debt
(
    scan_id UUID,

    component_name TEXT,

    score INTEGER,

    notes TEXT
);
