# .gitlab-ci.yml

stages:
  - prepare
  - deploy
  - consolidate

variables:
  HELM_NAMESPACE: "default"
  HELM_CHARTS_PATH: "./charts"
  KUBE_CONTEXT: "my-k8s-cluster"
  ENVIRONMENT: "dev"

prepare_matrix:
  stage: prepare
  image: alpine:3.20
  script:
    - apk add --no-cache bash jq
    - bash scripts/deploy.sh prepare_matrix
  artifacts:
    paths:
      - matrix.json
  when: always

deploy_each_app:
  stage: deploy
  needs:
    - prepare_matrix
  parallel:
    matrix:
      - APP_NAME: ["demo1", "demo2", "demo4"]
  image: alpine/helm:3.14.0
  script:
    - apk add --no-cache bash jq coreutils
    - export VERSION=$(jq -r --arg app "$APP_NAME" '.[$app]' matrix.json)
    - bash scripts/deploy.sh deploy_app "$APP_NAME" "$VERSION"
  artifacts:
    paths:
      - "deploy-output-${APP_NAME}.json"
      - "${APP_NAME}.log"
  when: always

consolidate_report:
  stage: consolidate
  image: alpine:3.20
  needs:
    - job: deploy_each_app
      optional: true
      artifacts: true
  script:
    - apk add --no-cache bash jq
    - bash scripts/deploy.sh consolidate
  artifacts:
    paths:
      - combined.json
      - report.html
      - deploy.log
  when: always

 
# scripts/deploy.sh

#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="deploy.log"
mkdir -p artifacts

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
log_info()  { echo -e "${BLUE}[INFO]${NC} $1" | tee -a "$LOG_FILE"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1" | tee -a "$LOG_FILE"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG_FILE" >&2; }
log_success(){ echo -e "${GREEN}[OK]${NC} $1" | tee -a "$LOG_FILE"; }

trap 'log_error "Unexpected error on line $LINENO"; exit 1' ERR

validate_inputs() {
  log_info "Validating inputs..."
  if [[ -z "${APPLICATIONS:-}" ]]; then
    log_error "APPLICATIONS variable is required (multi-line app=version pairs)."
    exit 1
  fi
  if [[ "${ENVIRONMENT,,}" == "prod" && -z "${CHANGE_RECORD:-}" ]]; then
    log_error "CHANGE_RECORD required for PROD."
    exit 1
  fi
}

prepare_matrix() {
  validate_inputs
  log_info "Building deployment matrix..."
  echo "{}" > matrix.json
  while IFS='=' read -r APP VERSION; do
    [[ -z "$APP" || -z "$VERSION" ]] && continue
    jq --arg app "$APP" --arg ver "$VERSION" '. + {($app): $ver}' matrix.json > tmp.$$.json && mv tmp.$$.json matrix.json
  done <<< "$APPLICATIONS"
  log_success "Matrix generated → matrix.json"
  jq . matrix.json
}

deploy_app() {
  local APP_NAME="$1"
  local VERSION="$2"
  log_info "Deploying $APP_NAME:$VERSION"
  local STATUS="SUCCESS"
  local ERRORS=""

  if ! helm upgrade --install "$APP_NAME" "$HELM_CHARTS_PATH/$APP_NAME" \
      --namespace "$HELM_NAMESPACE" \
      --create-namespace \
      --set image.tag="$VERSION" \
      --kube-context "$KUBE_CONTEXT" \
      > "${APP_NAME}.log" 2>&1; then
    STATUS="FAILED"
    ERRORS=$(grep -i "error" "${APP_NAME}.log" | head -5 | tr '\n' ' ')
  fi

  jq -n \
    --arg name "$APP_NAME" \
    --arg version "$VERSION" \
    --arg status "$STATUS" \
    --arg error "$ERRORS" \
    '{app_name:$name, version:$version, status:$status, error:$error}' \
    > "deploy-output-${APP_NAME}.json"

  log_success "Deployment complete → $APP_NAME ($STATUS)"
}

consolidate() {
  log_info "Consolidating JSON outputs..."
  jq -s '.' deploy-output-*.json > combined.json
  {
    echo "<html><head><style>body{font-family:sans-serif;}table{border-collapse:collapse;width:100%;}th,td{border:1px solid #888;padding:6px;}th{background:#222;color:#fff;}tr:nth-child(even){background:#eee;}</style></head><body>"
    echo "<h2>Helm Deployment Summary</h2><table><tr><th>App</th><th>Version</th><th>Status</th><th>Error</th></tr>"
    jq -c '.[]' combined.json | while read -r r; do
      APP=$(echo "$r" | jq -r '.app_name')
      VER=$(echo "$r" | jq -r '.version')
      STS=$(echo "$r" | jq -r '.status')
      ERR=$(echo "$r" | jq -r '.error')
      COLOR=$([[ "$STS" == "SUCCESS" ]] && echo "#d4edda" || echo "#f8d7da")
      echo "<tr style='background:$COLOR'><td>$APP</td><td>$VER</td><td>$STS</td><td>${ERR:-None}</td></tr>"
    done
    echo "</table></body></html>"
  } > report.html
  log_success "Report created → report.html"
}

case "${1:-}" in
  prepare_matrix) prepare_matrix ;;
  deploy_app) deploy_app "$2" "$3" ;;
  consolidate) consolidate ;;
  *) log_error "Usage: $0 {prepare_matrix|deploy_app|consolidate}"; exit 1 ;;
esac


#How to Run Locally
export APPLICATIONS="demo1=v1.0
demo2=v2.3"
export ENVIRONMENT=dev
export HELM_NAMESPACE=default
export HELM_CHARTS_PATH=./charts
export KUBE_CONTEXT=my-cluster
bash scripts/deploy.sh
