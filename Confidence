 ├── Commit
 │      │
 │      ├── Service
 │      ├── Controller
 │      ├── Entity
 │      ├── SQL
 │      └── Tests
 │
 ├── API
 ├── Database
 ├── MQ
 └── Configuration

The graph makes retrieval efficient and explainable.

